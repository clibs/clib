# fuzz_manifest.dict — dictionary for the existing clib manifest parser
# harness (test/fuzzing/fuzz_manifest.c → clib_package_load_from_manifest).
# Tokens cover the manifest grammar of clib.json / package.json files
# (untrusted supply-chain data) so mutations reach the deep parse paths:
# dependencies objects, flags arrays, src file lists and repo slugs.

key_name="\"name\""
key_repo="\"repo\""
key_version="\"version\""
key_license="\"license\""
key_description="\"description\""
key_dependencies="\"dependencies\""
key_development="\"development\""
key_src="\"src\""
key_files="\"files\""
key_install="\"install\""
key_configure="\"configure\""
key_makefile="\"makefile\""
key_flags="\"flags\""
key_cflags="\"cflags\""
key_prefix="\"prefix\""
key_keywords="\"keywords\""
key_author="\"author\""
key_url="\"url\""
repo_slug="clibs/clib"
repo_slug="jane/foo"
repo_slug="stephenmathieson/asprintf"
repo_url="https://github.com/clibs/clib"
repo_git="git@github.com:clibs/clib.git"
at_master="@master"
at_version="@1.0.0"
at_star="@*"
version="1.0.0"
version="0.1.0"
version="master"
version="*"
version="^2.0.0"
dep_version="\"*\""
c_file="foo.c"
c_file="src/foo.c"
h_file="foo.h"
flag="-O2"
flag="-std=c99"
license="MIT"
license="Apache-2.0"
escaped_nl="\\n"
escaped_quote="\\\""
escaped_unicode="\\u00e9"
separator=", "
colon=": "
open_obj="{"
close_obj="}"
open_arr="["
close_arr="]"
