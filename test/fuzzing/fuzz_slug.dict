# fuzz_slug.dict — tokens for the slug/URL/dependency harness.
# Input layout: <flags byte> slug \n version ; slug strings mirror
# dependency spec strings from untrusted manifests.

owner="clibs"
owner="jane"
owner="stephenmathieson"
owner="arthurscchan"
slash_owner="clibs/"
slash_owner="jane/"
name="clib"
name="asprintf"
name="parson"
name="commander"
at_version="@1.0.0"
at_version="@master"
at_version="@*"
at_version="@v2.0.1"
at_version="@0.1.0"
version="1.0.0"
version="master"
version="*"
version="v2.0.1"
version="0.1.0"
url_prefix="https://github.com/"
url_prefix="https://raw.githubusercontent.com/"
git_suffix=".git"
separator="\x0a"
dash="-"
